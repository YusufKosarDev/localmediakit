<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.12</version>
        <relativePath/>
    </parent>

    <groupId>com.localmediakit</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>localmediakit-backend</name>
    <description>LocalMediaKit backend - Step 0 architecture proof</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Tags kept out of the default `mvn test`. A property rather than a
            literal because excludedGroups wins over -Dgroups: with the tag
            hard-coded here, the job meant to run exactly these tests ran none
            of them and passed. A green build that executed nothing is worse
            than a red one.
        -->
        <surefire.excluded.groups>postgres</surefire.excluded.groups>
        <!-- One property for all three jjwt artifacts: they must move together,
             and separate versions arrive as three separate update proposals. -->
        <jjwt.version>0.13.0</jjwt.version>
        <!--
            Ahead of what the Boot BOM pins. The driver the BOM brings carries
            three fixed advisories, one of them in channel-binding
            authentication (CVE-2025-49146), and this is the driver the
            production database is reached with. Overriding the property is the
            supported way to move a managed version; drop it when the BOM
            catches up, which the vulnerability scan will not let us forget.
        -->
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Metrics backend for the actuator. Prometheus rather than a hosted
            vendor: the exposition format is scrapeable by anything, costs no
            account, and keeps the metric definitions in this repository rather
            than in somebody's dashboard.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Schema migrations (Flyway is the single source of truth for the schema) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT (JSON Web Token) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Runtime databases: H2 for local dev, PostgreSQL for production (Neon) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Stripe TEST MODE only: hosted Checkout + signed webhooks. -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>33.1.1</version>
        </dependency>

        <!-- In-memory token-bucket rate limiting (auth, beacon, unlock). -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.19.0</version>
        </dependency>

        <!-- Bounded, self-evicting caches for the rate-limit buckets. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger UI. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!--
                Tied to the Boot generation, not to taste: 2.6.x targets Boot
                3.3 and answers /v3/api-docs with a 500 on 3.5, which is a
                broken documentation page rather than a failed startup. 2.8.x
                is the line that tracks Boot 3.5; 3.x is for Boot 4 and moves
                with that upgrade, not before it.
            -->
            <version>2.8.17</version>
        </dependency>

        <!-- Lead notifications. Plain SMTP rather than a provider SDK: every
             candidate (Brevo, SendGrid, Resend, Mailgun) speaks it, so changing
             provider is a change of environment variables, not of code. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architecture rules as tests. Test scope only: nothing ships with it. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            A real PostgreSQL for the handful of tests where H2's compatibility
            mode is the thing under test rather than a convenience. Tagged
            "postgres" and excluded from the default run (see surefire below),
            so the fast suite stays fast and needs no Docker.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @ServiceConnection: points the context at the container without a
             single duplicated JDBC URL. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The Postgres tests need a Docker daemon, which `mvn test`
                        on a laptop cannot assume. Excluding them by tag keeps
                        the default build self-contained - the property the CI
                        comment already claims - while `-Dgroups=postgres` runs
                        exactly those, which is what the dedicated job does.
                    -->
                    <excludedGroups>${surefire.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Mutation testing. Kept in a profile because PIT re-runs the test
            suite once per mutation and almost every test here boots a Spring
            context — running it on every `mvn test` would make the ordinary
            build unusable. Invoked explicitly: mvn -Pmutation test
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.25.8</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!--
                                Scoped to the packages whose failure modes matter:
                                the publish/snapshot path, the ownership guards and
                                plan policy, the engagement calculators, analytics
                                aggregation, auth and rate limiting. The rest is
                                largely Spring wiring and DTOs, where a mutation
                                score says more about the framework than about
                                these tests.
                            -->
                            <targetClasses>
                                <!--
                                    The classes where a surviving mutant means a
                                    real hole, AND that the fast tests below actually cover. Pairing a
                                    class with tests that never touch it reports
                                    NO_COVERAGE and makes the score meaningless —
                                    the first draft did exactly that and read 67%.

                                    Scope: slug generation, the
                                    ownership guard, plan policy, the appearance
                                    and locale whitelists, slug generation, the
                                    engagement strategies, the visitor beacon's
                                    anti-abuse helpers, JWT, and rate limiting.

                                    Broader package globs were tried and
                                    abandoned: with nearly every test booting a
                                    Spring context, PIT ran past 18 minutes and
                                    started killing minions on timeout. A scope
                                    that finishes is worth more than one that
                                    nobody waits for.
                                -->
                                <param>com.localmediakit.mediakit.SlugService</param>
                                <param>com.localmediakit.shared.ClientIp</param>
                                <param>com.localmediakit.ratelimit.RateLimitFilter</param>
                                <param>com.localmediakit.ratelimit.RateLimiterRegistry</param>
                                <param>com.localmediakit.stats.engagement.*</param>
                                <param>com.localmediakit.domain.ReentrancyGuard</param>
                                <!--
                                    The backward-compatibility rules for already
                                    published snapshots. The product's central
                                    promise is that a published page does not
                                    change until its owner republishes, and
                                    these accessors are where that survives
                                    every field added since. They were outside
                                    this scope while the only tests touching
                                    them booted Spring.
                                -->
                                <param>com.localmediakit.mediakit.MediaKitSnapshot</param>
                                <!-- The curated look list the contrast guarantee rests on. -->
                                <param>com.localmediakit.mediakit.KitAppearance</param>
                                <!-- The bot gate in front of every anonymous public write. -->
                                <param>com.localmediakit.analytics.UserAgents</param>
                                <param>com.localmediakit.shared.ConstraintRetry</param>
                                <!-- Exported cells carry text a stranger typed. -->
                                <param>com.localmediakit.shared.Csv</param>
                                <param>com.localmediakit.observability.RequestIdFilter</param>
                            </targetClasses>
                            <targetTests>
                                <!--
                                    Only the tests that do NOT boot Spring. PIT
                                    re-runs the selected suite for every mutation,
                                    so pointing it at the @SpringBootTest classes
                                    meant minutes per mutation and minions dying on
                                    timeout. Pairing fast tests with the pure-logic
                                    classes above gives a score that is both
                                    trustworthy and cheap enough to run weekly.
                                -->
                                <param>com.localmediakit.stats.engagement.*</param>
                                <param>com.localmediakit.mediakit.SlugServiceTest</param>
                                <param>com.localmediakit.shared.ClientIpTest</param>
                                <param>com.localmediakit.domain.ReentrancyGuardTest</param>
                                <param>com.localmediakit.domain.DomainVerificationLogicTest</param>
                                <param>com.localmediakit.ratelimit.RateLimitRoutingTest</param>
                                <param>com.localmediakit.mediakit.MediaKitSnapshotTest</param>
                                <param>com.localmediakit.mediakit.KitAppearanceTest</param>
                                <param>com.localmediakit.analytics.UserAgentsTest</param>
                                <param>com.localmediakit.shared.ConstraintRetryTest</param>
                                <param>com.localmediakit.shared.CsvTest</param>
                                <param>com.localmediakit.observability.RequestIdFilterTest</param>
                            </targetTests>
                            <!--
                                Accessors only. Mutating a getter's return value is
                                not a signal about test quality, and writing
                                assertions for entity getters would lift the score
                                without finding a single bug.
                            -->
                            <excludedMethods>
                                <param>get*</param>
                                <param>is*</param>
                                <param>set*</param>
                            </excludedMethods>
                            <!--
                                Set below the measured score rather than at it: a
                                refactor that adds one uncovered branch should not
                                break the build, a real regression should. Raise it
                                when the measured number moves up and holds.
                            -->
                            <!--
                                A mutated retry/backoff loop can hang a minion; PIT
                                kills it as TIMED_OUT rather than reporting a
                                survivor, but the default budget is tight for a
                                suite where each test boots Spring.
                            -->
                            <timeoutConstant>10000</timeoutConstant>
                            <!--
                                Raised from 90 as the note above intended, once
                                the measured score moved to 97.6% and held.
                                Still below the measurement: the three survivors
                                are equivalent mutants and cannot be killed, so
                                a threshold at the measured number would make
                                the build depend on nobody ever adding a fourth.

                                The equivalents, so the next person does not
                                spend an afternoon on them: both "changed
                                conditional boundary" survivors sit on
                                `length() > MAX` guards where the mutated `>=`
                                takes substring(0, MAX) of a string of exactly
                                MAX characters - the same string. The
                                ReentrancyGuard one replaces a `return true`
                                with `true`.
                            -->
                            <mutationThreshold>95</mutationThreshold>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
