# Backend environment variables.
# Local dev works with zero config (H2 + defaults). These are for PRODUCTION (Render).

# Activate the production profile (Postgres/Neon)
SPRING_PROFILES_ACTIVE=prod

# Neon Postgres (JDBC form). Get these from the Neon dashboard connection string.
#   DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# --- Required in production -------------------------------------------------
# The prod profile refuses to start while any of these still holds its
# development default (see ProductionSecretsCheck). Generate long random values.

# Signs session tokens. HS256 needs at least 32 bytes. Leaking or defaulting
# this means anyone can mint a token for any account.
JWT_SECRET=

# Frontend on-demand revalidation target (your Vercel deployment)
REVALIDATE_URL=https://<your-app>.vercel.app/api/revalidate
# Must match REVALIDATE_SECRET on the frontend.
REVALIDATE_SECRET=

# Salts the anonymous visitor fingerprint. A guessable salt is what turns those
# hashes back into identifiable visitors.
ANALYTICS_SALT=

# Browser origins allowed to call this API (comma-separated). The dashboard.
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# Absolute base for links the backend hands out (lead notification emails,
# Stripe return URLs). No trailing slash.
FRONTEND_URL=https://<your-app>.vercel.app

# --- Optional integrations --------------------------------------------------
# All of these are graceful-enable: left blank, the feature stays dark and
# nothing else is affected.

# Lead notification emails over plain SMTP. Any provider works (Brevo,
# SendGrid, Resend, Mailgun); a blank MAIL_HOST or MAIL_FROM keeps them off.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=LocalMediaKit

# YouTube Data API v3 key. Blank = the stats sync feature is not offered.
YOUTUBE_API_KEY=

# Stripe TEST MODE keys. Blank/dummy = checkout answers 503 and the demo
# plan-switch endpoint stays available instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
