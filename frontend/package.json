{
  "name": "localmediakit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "demo:record": "playwright test --config=playwright.demo.config.ts",
    "demo:gif": "node demo/to-gif.mjs",
    "demo": "pnpm run demo:record && pnpm run demo:gif"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/blob": "2.8.2",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "postcss": "^8.5.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.0"
    },
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
