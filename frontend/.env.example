# Copy to .env.local for local development (never commit .env.local)

# Server-side: used by the public [slug] page to fetch from the backend.
BACKEND_URL=http://localhost:8080
REVALIDATE_SECRET=local-dev-secret

# Browser-side: used by the dashboard (login/register/me). Must be NEXT_PUBLIC_.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Avatar uploads (Vercel Blob). Leave it unset and the feature stays dark: the
# upload endpoint answers 503, the dashboard hides the upload control, and the
# avatar URL field carries on working. Uploads have to go to a CDN rather than
# to the backend, because the published page is served from the edge and must
# not break when that instance is asleep.
BLOB_READ_WRITE_TOKEN=
